{
  "breathing_estimator": {
    "window_size": 300,
    "overlap": 0.5,
    "bandpass_filter": {
      "low_cut": 0.1,
      "high_cut": 0.6,
      "order": 4
    },
    "fft_method": {
      "enabled": true,
      "padding_ratio": 4
    },
    "subcarrier_selection": {
      "method": "variance",
      "top_n": 5
    },
    "smoothing": {
      "enabled": true,
      "window_size": 3
    }
  },
  "data_paths": {
    "evaluation_dir": "data/breathing_rate/evaluation",
    "test_dir": "data/breathing_rate/test",
    "results_dir": "results"
  },
  "mqtt": {
    "host": "localhost",
    "port": 1883,
    "topic_csi": "esp32/csi",
    "topic_result": "esp32/breathing_result"
  }
}